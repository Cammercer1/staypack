{
  "name": "staypack-public-reports",
  "account_id": "fc594f30144c9ba2a1cb9a5c3ce1313a",
  "main": "../.report-worker/worker.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "send_metrics": false,
  "minify": true,
  "placement": { "region": "aws:ap-northeast-1" },
  "cache": { "enabled": false },
  "assets": {
    "directory": "../.report-worker/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/examples/*", "/example/*", "/proposal/*"]
  },
  "routes": [
    { "pattern": "staypack.app/examples/*", "zone_name": "staypack.app" },
    { "pattern": "staypack.app/example/*", "zone_name": "staypack.app" },
    { "pattern": "staypack.app/proposal/*", "zone_name": "staypack.app" },
    { "pattern": "staypack.app/_report-viewer/*", "zone_name": "staypack.app" },
    { "pattern": "staypack.app/fonts/*", "zone_name": "staypack.app" },
    { "pattern": "staypack.app/brands/*", "zone_name": "staypack.app" }
  ],
  "observability": { "enabled": false }
}
