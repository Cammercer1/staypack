{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "staypack-app-preview",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": [
    "nodejs_compat", "global_fetch_strictly_public"
  ],
  "main": "cloudflare/app-preview-entry.ts",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "account_id": "fc594f30144c9ba2a1cb9a5c3ce1313a",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "cache": {
    "enabled": false
  },
  "placement": {
    "region": "aws:ap-northeast-1"
  },
  "vars": {
    "CLOUDFLARE_APP": "1",
    "APP_ENV": "production",
    "SITE_URL": "https://staypack-app-preview.cameronmercer1991.workers.dev",
    "NEXT_PUBLIC_SITE_URL": "https://staypack-app-preview.cameronmercer1991.workers.dev",
    "NEXT_PUBLIC_REPORTS_URL": "https://staypack-app-preview.cameronmercer1991.workers.dev"
  },
  "services": [
    {
      "binding": "PUBLIC_REPORTS",
      "service": "staypack-public-reports"
    }
  ],
  "limits": {
    "cpu_ms": 30000
  },
  "queues": {
    "producers": [
      {
        "binding": "APPRAISAL_JOBS",
        "queue": "staypack-preview-appraisals"
      }
    ],
    "consumers": [
      {
        "queue": "staypack-preview-appraisals",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 2,
        "dead_letter_queue": "staypack-preview-appraisals-dead"
      }
    ]
  }
}
