# Local dev — use localhost. Production (Netlify): https://staypack.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REPORTS_URL=http://localhost:3000
# Server/runtime canonical URL (Netlify production — avoids netlify.app in QR/links)
SITE_URL=https://staypack.app

# Development project credentials belong only in your private .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

# New STR estimates use AirROI. Keep the Airbtics key only for legacy tooling.
AIRROI_API_KEY=
AIRBTICS_API_KEY=
AIRBTICS_BASE_URL=https://crap0y5bx5.execute-api.us-east-2.amazonaws.com/prod

BROWSERLESS_API_KEY=
# Host only — no path or ?token= query string
BROWSERLESS_BASE_URL=https://production-sfo.browserless.io
# Optional timeout for /smart-scrape in milliseconds
BROWSERLESS_TIMEOUT_MS=60000
# Set to 1 to test Domain Browserless fetch via npm run dev (requires BROWSERLESS_API_KEY)
FORCE_DOMAIN_BROWSER=

# Bright Data — REA listing scrape (primary import path when configured)
BRIGHTDATA_API_KEY=
BRIGHTDATA_REA_DATASET_ID=gd_l3cvjh111l943r4awk
# Web Unlocker zone name — required for Domain import and REA search discovery
BRIGHTDATA_UNLOCKER_ZONE=listing_unlocker
# Optional scrape timeout in milliseconds (default 25000)
BRIGHTDATA_SCRAPE_TIMEOUT_MS=25000
# Optional REA dataset scrape timeout in milliseconds (default max(BRIGHTDATA_SCRAPE_TIMEOUT_MS, 60000))
BRIGHTDATA_REA_SCRAPE_TIMEOUT_MS=60000
# REA rent discover SERP crawl (default 180000) — used for lease rental band + comps
BRIGHTDATA_REA_DISCOVER_TIMEOUT_MS=180000

# REA data provider. RapidAPI is primary when configured; Apify remains the
# automatic fallback. Set to apify for an emergency provider rollback.
REA_PRIMARY_PROVIDER=rapidapi

# RapidAPI — Realestate com AU by oneapiproject (server-side only)
RAPIDAPI_REA_KEY=
RAPIDAPI_REA_HOST=realestate-com-au4.p.rapidapi.com
RAPIDAPI_REA_MAX_LISTINGS=100
RAPIDAPI_REA_TIMEOUT_MS=30000
# Keep at or below the subscribed plan's per-second allowance.
RAPIDAPI_REA_MAX_CONCURRENCY=4
RAPIDAPI_REA_MAX_RETRIES=1

# US property profiles and sale/rental comparables (Real-Time Real Estate Data / Zillow).
# Optional dedicated key; falls back to RAPIDAPI_REA_KEY. Requires the API subscription.
RAPIDAPI_US_PROPERTY_KEY=

# RapidAPI — Domain AU exact-address AVM (uses RAPIDAPI_REA_KEY)
RAPIDAPI_DOMAIN_HOST=domain-au.p.rapidapi.com
RAPIDAPI_DOMAIN_TIMEOUT_MS=20000
RAPIDAPI_DOMAIN_AVM_TTL_HOURS=720
# Set false for an immediate Domain AVM rollback; REA-only appraisals continue.
RAPIDAPI_DOMAIN_AVM_ENABLED=true

# Apify — REA listing import + comps fallback (memo23/realestate-au-listings actor)
APIFY_API_KEY=
# Optional actor override (default qBUaDtdr6kYSBZE8J)
APIFY_REA_ACTOR_ID=
# Max listings per rent search (default 50)
APIFY_REA_MAX_LISTINGS=50
# Actor sync timeout in ms (default 240000)
APIFY_REA_TIMEOUT_MS=240000
# Shared Supabase comparable-search cache. Fail-open and enabled by default when
# service-role configuration exists; set false for an immediate kill switch.
REA_COMPARABLE_CACHE_ENABLED=true
# Cache freshness: rentals 3 days, active sales 7 days, sold searches 30 days.
REA_RENT_CACHE_TTL_HOURS=72
REA_BUY_CACHE_TTL_HOURS=168
REA_SOLD_CACHE_TTL_HOURS=720

# PropRadar — address → rental estimate (optional; not wired to lease brochure v1)
PROP_RADAR_API_KEY=

# Server-side key: enable Geocoding API and Places API (New).
GOOGLE_MAPS_API_KEY=

QR_CODE_BASE_URL=http://localhost:3000

APP_ENV=development

# Agency billing. Disabled until the migration, catalogue and webhook are ready.
# Server-side values only. Test and live use different accounts/keys/prices.
BILLING_MODE=disabled
BILLING_SITE_URL=http://localhost:3000
BILLING_PLANS_JSON=[]
BILLING_CRON_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
# Hosted Checkout does not require a browser/publishable key.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
# Enable only after configuring your applicable tax registrations and product tax code.
STRIPE_AUTOMATIC_TAX=false
# The Australian agency plan uses its gstTaxRateId for fixed 10% GST on all items.
# Keep Automatic Tax false when that plan is configured; do not enable both.

# Managed delivery platform (cron + tenant STR email delivery)
DELIVERY_CRON_SECRET=
RESEND_API_KEY=
DELIVERY_FROM_EMAIL=StayPacks Delivery <reports@staypack.app>
# E2E script: npx tsx scripts/run-haven-delivery-e2e.mjs your@email.com
DELIVERY_TEST_EMAIL=
# Optional webhook for failed delivery runs (Slack-compatible JSON POST)
DELIVERY_ALERT_WEBHOOK_URL=

# Optional: agency id for unauthenticated brochure preview fallback (server only).
SALES_BROCHURE_PREVIEW_AGENCY_ID=
# Optional: agent name to use in brochure previews (default: Harvey Specter).
SALES_BROCHURE_PREVIEW_AGENT_NAME=Harvey Specter
# File storage: keep Supabase for database/auth. Enable R2 only after buckets and
# the public custom domain are ready. These credentials are server-only.
STORAGE_PROVIDER=supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=staypack-public
R2_PRIVATE_BUCKET=staypack-private
R2_PUBLIC_BASE_URL=https://assets.staypack.app
